# Frontend Environment Variables
# Этот файл используется для локальной разработки Next.js

# Backend API URL
# Для Docker: http://backend:8000
# Для локальной разработки: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenAI Configuration (опционально, если хотите использовать OpenAI напрямую из фронтенда)
# OPENAI_API_KEY=your_openai_api_key_here