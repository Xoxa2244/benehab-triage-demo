{
  "sensitive": {
    "name": "Sensitive",
    "short_desc": "Vulnerability, high sensitivity, tendency to somatic complaints and fatigue.",
    "tone": "soft, gentle, validating feelings",
    "do": [
      "start by acknowledging sensations and anxieties",
      "give step-by-step, simple instructions",
      "suggest supportive practices (sleep, water, breathing)"
    ],
    "avoid": [
      "harsh formulations and pressure",
      "devaluing complaints"
    ],
    "motivators": ["care", "safety", "support"],
    "red_flags": ["overwhelming fatigue", "increased somatovegetative complaints"]
  },
  "dysthymic": {
    "name": "Dysthymic",
    "short_desc": "Tendency to low mood background, self-criticism, guilt feelings.",
    "tone": "supportive, structuring",
    "do": [
      "give small achievable steps",
      "emphasize progress and efforts",
      "suggest regularity and routine"
    ],
    "avoid": [
      "high expectations immediately",
      "irony and comparisons"
    ],
    "motivators": ["stability", "predictability", "approval"],
    "red_flags": ["increased hopelessness", "suicidal thoughts"]
  },
  "demonstrative": {
    "name": "Demonstrative",
    "short_desc": "Need for recognition, desire to make an impression.",
    "tone": "partnership, acknowledging contribution",
    "do": [
      "give space to 'report' on successes",
      "suggest socially visible goals ('keep the plan')",
      "use recognition formulations"
    ],
    "avoid": [
      "ignoring feedback",
      "reducing to 'invention'"
    ],
    "motivators": ["social approval", "leadership role", "visible result"],
    "red_flags": ["accumulation of unfulfilled promises"]
  },
  "excitable": {
    "name": "Excitable",
    "short_desc": "Impulsiveness, outbursts of irritation, craving for immediate action.",
    "tone": "clear, without unnecessary details",
    "do": [
      "give brief instructions",
      "fix immediate steps with deadline",
      "build in release/movement"
    ],
    "avoid": [
      "lots of text and theory",
      "long waits for response"
    ],
    "motivators": ["dynamics", "control through action"],
    "red_flags": ["increased aggression", "breakdown on loved ones"]
  },
  "cyclothymic": {
    "name": "Cyclothymic",
    "short_desc": "Alternation of ups and downs, variability of activity and mood.",
    "tone": "even, normalizing fluctuations",
    "do": [
      "plan for 'good' and 'down' periods",
      "reminders and auto-steps for down period",
      "build flexibility into the routine"
    ],
    "avoid": [
      "rigid schedule without options",
      "evaluative judgments"
    ],
    "motivators": ["flexibility", "awareness of rhythms"],
    "red_flags": ["prolonged downturn", "long-term apathy"]
  },
  "stuck": {
    "name": "Stuck",
    "short_desc": "Persistence, long experience of grievances, principledness.",
    "tone": "respectful, factual",
    "do": [
      "acknowledge efforts and resistance",
      "translate into constructive frameworks ('what's under control')",
      "clear criteria for results"
    ],
    "avoid": [
      "devaluing persistence",
      "sudden plan changes"
    ],
    "motivators": ["justice", "completion", "consistency"],
    "red_flags": ["escalation of conflicts", "excessive rigidity"]
  },
  "pedantic": {
    "name": "Pedantic",
    "short_desc": "Caution, orientation to order, tendency to doubt.",
    "tone": "structural, step by step",
    "do": [
      "checklists and control points",
      "clarify risks/benefits",
      "clear rules and hygiene"
    ],
    "avoid": [
      "uncertainty",
      "rush without explanations"
    ],
    "motivators": ["predictability", "clean protocols"],
    "red_flags": ["paralysis by choice", "expanded anxiety"]
  },
  "anxious": {
    "name": "Anxious/Avoidant",
    "short_desc": "Desire for solitude, limiting contacts, internal tension.",
    "tone": "calm, safe, without pressure",
    "do": [
      "first reduce anxiety (breathing/windows of tolerance)",
      "micro-steps, fewer contacts at once",
      "confirmation of right to pause"
    ],
    "avoid": [
      "social pressure",
      "crowded/rigid formats"
    ],
    "motivators": ["safety", "contact control"],
    "red_flags": ["isolation", "panic symptoms"]
  },
  "hyperthymic": {
    "name": "Hyperthymic",
    "short_desc": "Elevated mood background, activity, craving for novelty and contacts.",
    "tone": "energetic, goal-oriented",
    "do": [
      "goal setting with visible benefit",
      "varied tasks and progress tracker",
      "rely on social support"
    ],
    "avoid": [
      "monotonous tasks without meaning",
      "long pauses"
    ],
    "motivators": ["novelty", "movement", "people"],
    "red_flags": ["overwork", "attention dispersion"]
  }
}